{
  "name": "ortak-oyuncu-ranked-production-sweeper",
  "main": "../../server/ranked-production-sweeper-worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "RANKED_SWEEPER_ENABLED": "true",
    "RANKED_SWEEPER_SCOPE": "production"
  },
  "d1_databases": [
    {
      "binding": "RANKED_PRODUCTION_DB",
      "database_name": "ortak-oyuncu-ranked",
      "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID"
    }
  ]
}
